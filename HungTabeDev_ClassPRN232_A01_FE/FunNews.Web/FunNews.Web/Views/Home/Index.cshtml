@model List<FunNews.Web.Models.DTOs.NewsArticleDTO>

<h2>News Articles</h2>
@foreach (var article in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@article.NewsTitle</h5>
            <p class="card-text">@article.NewsContent</p>
            <a href="@article.NewsContent" class="btn btn-primary">Read More</a>
        </div>
    </div>
}