@model List<FunNews.Web.Models.DTOs.NewsArticleDTO>

<h2>My News History</h2>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Created Date</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var article in Model)
        {
            <tr>
                <td>@article.NewsArticleId</td>
                <td>@article.NewsTitle</td>
                <td>@article.CreatedDate.ToString("yyyy-MM-dd")</td>
                <td>@(article.NewsStatus ? "Active" : "Inactive")</td>
            </tr>
        }
    </tbody>
</table>