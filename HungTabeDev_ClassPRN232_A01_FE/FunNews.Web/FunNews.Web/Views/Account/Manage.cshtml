@model List<FunNews.Web.Models.DTOs.SystemAccountDTO>

<h2>Manage Accounts</h2>

@if (TempData["Success"] != null)
{
    <script>
        showAlert('@TempData["Success"]', 'success');
    </script>
}
@if (TempData["Error"] != null)
{
    <script>
        showAlert('@TempData["Error"]', 'error');
    </script>
}

<a asp-action="Create" class="btn btn-primary mb-3">Create New Account</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var account in Model)
        {
            <tr>
                <td>@account.AccountId</td>
                <td>@account.AccountName</td>
                <td>@account.AccountEmail</td>
                <td>@(account.AccountRole == 0 ? "Admin" : account.AccountRole == 1 ? "Staff" : "Lecturer")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@account.AccountId" class="btn btn-warning">Edit</a>
                    <form asp-action="Delete" asp-route-id="@account.AccountId" method="post" class="delete-form" style="display:inline;">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}