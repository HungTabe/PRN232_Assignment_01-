@model FunNews.Web.Models.DTOs.SystemAccountDTO

<h2>My Profile</h2>

@if (TempData["Success"] != null)
{
    <script>
        showAlert('@TempData["Success"]', 'success');
    </script>
}

<form asp-action="Profile" method="post">
    <input type="hidden" asp-for="AccountId" />
    <div class="form-group">
        <label asp-for="AccountName"></label>
        <input asp-for="AccountName" class="form-control" />
        <span asp-validation-for="AccountName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="AccountEmail"></label>
        <input asp-for="AccountEmail" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label asp-for="AccountRole"></label>
        <input asp-for="AccountRole" class="form-control" readonly value="@(Model.AccountRole == 0 ? "Admin" : Model.AccountRole == 1 ? "Staff" : "Lecturer")" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}